#include <iostream>
#include <stack>
using namespace std;

struct Frame
{
    int n;
    char from, to, aux;
    int step;
};

int main()
{
    int n;

    cout << "Enter number of disks: ";
    cin >> n;

    stack<Frame> s;

    s.push({n, 'A', 'C', 'B', 0});

    while (!s.empty())
    {
        Frame &current = s.top();

        if (current.n == 1)
        {
            cout << "Move disk 1 from "
                 << current.from << " to "
                 << current.to << endl;

            s.pop();
        }
        else if (current.step == 0)
        {
            current.step = 1;

            s.push({current.n - 1,
                    current.from,
                    current.aux,
                    current.to,
                    0});
        }
        else if (current.step == 1)
        {
            cout << "Move disk " << current.n
                 << " from " << current.from
                 << " to " << current.to << endl;

            current.step = 2;

            s.push({current.n - 1,
                    current.aux,
                    current.to,
                    current.from,
                    0});
        }
        else
        {
            s.pop();
        }
    }

    return 0;
}
